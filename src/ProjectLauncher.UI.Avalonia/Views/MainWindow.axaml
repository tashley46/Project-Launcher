<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectLauncher.ViewModels"
        xmlns:views="using:ProjectLauncher.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="ProjectLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="760"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        Icon="/Assets/avalonia-logo.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="Project Launcher">

    <Grid ColumnDefinitions="220,*">
        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="20,24">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="34" Height="34" CornerRadius="10"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="P"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="17" />
                    </Border>
                    <TextBlock Text="Project Launcher"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,34,0,0" Spacing="8">
                    <TextBlock Text="WORKSPACE"
                               Margin="10,0,0,4"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <Button Classes="nav-item selected" Content="Projects" HorizontalContentAlignment="Left"
                            Click="Projects_OnClick" />
                    <Button Classes="nav-item" Content="Favorites" HorizontalContentAlignment="Left" />
                    <Button Classes="nav-item" Content="Archived" HorizontalContentAlignment="Left"
                            Click="Archived_OnClick" />
                </StackPanel>

                <Border Grid.Row="3" Classes="sidebar-tip" Padding="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Local-first workspace"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Your project data stays on this device."
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="32,26">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Projects"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Pick up where you left off without rebuilding context."
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="primary-action"
                        Content="+  Add project"
                        Click="AddProject_OnClick"
                        IsEnabled="{Binding !IsBusy}"
                        IsVisible="{Binding IsProjectView}"
                        VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,28,0,0">
                <StackPanel Spacing="20">
                    <ProgressBar IsVisible="{Binding IsBusy}"
                                 IsIndeterminate="True"
                                 Height="3"
                                 Foreground="{DynamicResource AccentBrush}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                        <Border Classes="metric-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Projects" Classes="metric-label" />
                                <TextBlock Text="{Binding ProjectCount}" Classes="metric-value" />
                                <TextBlock Text="Folders on your dashboard" Classes="metric-caption" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="metric-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Active" Classes="metric-label" />
                                <TextBlock Text="{Binding ActiveProjectCount}" Classes="metric-value" />
                                <TextBlock Text="Projects ready to resume" Classes="metric-caption" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="metric-card accent-metric">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Current streak" Classes="metric-label inverted" />
                                <TextBlock Text="{Binding CurrentStreakDays}" Classes="metric-value inverted" />
                                <TextBlock Text="Development days" Classes="metric-caption inverted" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border IsVisible="{Binding HasError}"
                            Background="#FFF1F2"
                            BorderBrush="#FECDD3"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#9F1239"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="1"
                                    Content="Dismiss"
                                    Click="DismissError_OnClick"
                                    Background="Transparent"
                                    Foreground="#9F1239" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding WorkspaceTitle}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding WorkspaceSubtitle}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="neutral-pill" VerticalAlignment="Center">
                            <TextBlock Text="Local projects" FontSize="12" />
                        </Border>
                    </Grid>

                    <Border IsVisible="{Binding HasNoProjects}"
                            Classes="dashboard-card"
                            Padding="48">
                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <Border Width="52" Height="52" CornerRadius="16"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="+"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="28"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="No projects here yet"
                                       HorizontalAlignment="Center"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Choose a local folder and Project Launcher will remember it."
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Classes="primary-action"
                                    Margin="0,8,0,0"
                                    Content="Choose folder"
                                    Click="AddProject_OnClick"
                                    IsEnabled="{Binding !IsBusy}"
                                    IsVisible="{Binding IsProjectView}"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Projects}"
                                  IsVisible="{Binding HasProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectCardViewModel">
                                <views:ProjectCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
