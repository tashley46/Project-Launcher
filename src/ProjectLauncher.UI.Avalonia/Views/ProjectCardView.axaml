<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProjectLauncher.ViewModels"
             x:Class="ProjectLauncher.Views.ProjectCardView"
             x:DataType="vm:ProjectCardViewModel">
    <Border Classes="dashboard-card" Margin="0,0,0,12" Padding="22">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="★"
                               IsVisible="{Binding IsFavorite}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="17" />
                    <TextBlock Text="{Binding Name}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Classes="status-pill" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Lifecycle}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding FolderPath}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border Grid.Column="1"
                    Width="42"
                    Height="42"
                    CornerRadius="12"
                    Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="↗"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Margin="0,18,0,0"
                        Spacing="8">
                <Border Classes="neutral-pill">
                    <TextBlock Text="{Binding RepositoryStatus}" FontSize="12" />
                </Border>
                <Border Classes="neutral-pill">
                    <TextBlock Text="{Binding BranchLabel}" FontSize="12" />
                </Border>
                <Border Classes="neutral-pill">
                    <TextBlock Text="{Binding WorkingTreeStatus}" FontSize="12" />
                </Border>
                <Border Classes="neutral-pill">
                    <TextBlock Text="{Binding StreakLabel}" FontSize="12" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Grid.ColumnSpan="2"
                  ColumnDefinitions="*,Auto"
                  Margin="0,20,0,0">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding LatestCommitSummary}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding LatestCommitDateLabel}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary-action"
                            Content="Edit"
                            IsVisible="{Binding IsActiveProject}"
                            Command="{Binding BeginEditCommand}" />
                    <Button Classes="secondary-action"
                            Content="{Binding ArchiveButtonLabel}"
                            Command="{Binding ChangeArchiveStateCommand}" />
                    <Button Classes="secondary-action"
                            Content="{Binding DetailsButtonLabel}"
                            Command="{Binding ViewProjectCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="3"
                    Grid.ColumnSpan="2"
                    IsVisible="{Binding IsDetailsVisible}"
                    Margin="0,20,0,0"
                    Padding="18"
                    CornerRadius="14"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="5" IsVisible="{Binding !IsEditing}">
                        <TextBlock Text="Project details" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding IsEditing}">
                        <TextBlock Text="Edit project" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="NAME" Classes="metric-label" />
                        <TextBox Text="{Binding EditName}" PlaceholderText="Project name" />
                        <TextBlock Text="DESCRIPTION" Classes="metric-label" />
                        <TextBox Text="{Binding EditDescription}"
                                 PlaceholderText="Optional description"
                                 AcceptsReturn="True"
                                 MinHeight="72"
                                 TextWrapping="Wrap" />
                        <TextBlock Text="LIFECYCLE" Classes="metric-label" />
                        <ComboBox ItemsSource="{Binding LifecycleOptions}"
                                  SelectedItem="{Binding EditLifecycle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary-action" Content="Save changes"
                                    Command="{Binding SaveEditCommand}" />
                            <Button Classes="secondary-action" Content="Cancel"
                                    Command="{Binding CancelEditCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24"
                          IsVisible="{Binding !IsEditing}">
                        <StackPanel Spacing="5">
                            <TextBlock Text="GIT ROOT" Classes="metric-label" />
                            <TextBlock Text="{Binding GitRootPath}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="BRANCH" Classes="metric-label" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding BranchLabel}" />
                            <TextBlock Text="WORKING TREE" Classes="metric-label" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding WorkingTreeStatus}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FileChangeSummary}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="REMOTES" Classes="metric-label" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding RemoteLabel}" />
                            <TextBlock Text="CREATED" Classes="metric-label" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding CreatedLabel}" />
                            <TextBlock Text="LAST OPENED" Classes="metric-label" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding LastOpenedLabel}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="GITHUB" Classes="metric-label" />
                            <TextBlock Text="{Binding GitHubRepositoryLabel}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GitHubUrl}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="DEFAULT BRANCH" Classes="metric-label" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding DefaultBranchLabel}" />
                            <TextBlock Text="REMOTE" Classes="metric-label" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding OriginalRemoteUrl}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="STREAK" Classes="metric-label" />
                                <Button Grid.Column="1"
                                        Classes="secondary-action"
                                        Content="Refresh"
                                        IsVisible="{Binding IsActiveProject}"
                                        Command="{Binding RefreshStreakCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding StreakLabel}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding LongestStreakLabel, StringFormat='Longest: {0}'}" />
                            <TextBlock Text="{Binding ActiveDaysLabel}" />
                            <TextBlock Text="LAST MATCHING COMMIT" Classes="metric-label" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding LastCommitLabel}" />
                            <TextBlock Text="{Binding CalculatedLabel, StringFormat='Calculated: {0}'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
