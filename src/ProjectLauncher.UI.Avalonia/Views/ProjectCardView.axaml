<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProjectLauncher.ViewModels"
             x:Class="ProjectLauncher.Views.ProjectCardView"
             x:DataType="vm:ProjectCardViewModel">
    <Border Classes="dashboard-card" Margin="0,0,0,12" Padding="22">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Name}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Classes="status-pill" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Lifecycle}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding FolderPath}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border Grid.Column="1"
                    Width="42"
                    Height="42"
                    CornerRadius="12"
                    Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="↗"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Margin="0,18,0,0"
                        Spacing="8">
                <Border Classes="neutral-pill">
                    <TextBlock Text="{Binding RepositoryStatus}" FontSize="12" />
                </Border>
                <Border Classes="neutral-pill">
                    <TextBlock Text="{Binding StreakLabel}" FontSize="12" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Grid.ColumnSpan="2"
                  ColumnDefinitions="*,Auto"
                  Margin="0,20,0,0">
                <TextBlock Text="Ready to resume when you are."
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Grid.Column="1" Classes="secondary-action" Content="View project" />
            </Grid>
        </Grid>
    </Border>
</UserControl>

